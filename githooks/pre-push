#!/bin/sh
# Taurus delivery standard: keep local agent config from reaching a remote.
#
# git passes the refs being pushed on stdin as "<local ref> <local sha> <remote ref>
# <remote sha>", so this checks the commits actually being sent, including history,
# rather than the tip tree. A `git rm --cached` plus a commit leaves the blob in
# history, and this catches that.
#
# stdin is buffered once and replayed to the repository's own hook. Draining it and
# then exec'ing leaves that hook with nothing to read, which silently turns off every
# branch-protection and secret-scanning pre-push hook on the machine.
#
# Installed by taurus-skill/install.sh via core.hooksPath.

set -e

REFS="$(cat)"

chain() {
    GIT_DIR_PATH="$(git rev-parse --git-dir 2>/dev/null || true)"
    REPO_HOOK="${GIT_DIR_PATH:+$GIT_DIR_PATH/hooks/pre-push}"
    if [ -n "$REPO_HOOK" ] && [ -x "$REPO_HOOK" ] && [ "$REPO_HOOK" != "$0" ]; then
        printf '%s\n' "$REFS" | "$REPO_HOOK" "$@"
        exit $?
    fi
    exit 0
}

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$ROOT" ] && [ -f "$ROOT/.taurus-skill-source" ]; then
    chain "$@"
fi

ZERO="0000000000000000000000000000000000000000"
PATTERN='(^|/)(CLAUDE\.md|AGENTS\.md|\.mcp\.json)$|(^|/)\.claude(/|$)'
FOUND=""

FOUND="$(printf '%s\n' "$REFS" | while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$ZERO" ] && continue
    if [ "$remote_sha" = "$ZERO" ] || [ -z "$remote_sha" ]; then
        RANGE="$local_sha --not --remotes"
    else
        RANGE="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    git log --name-only --format= $RANGE 2>/dev/null | grep -E "$PATTERN" || true
done | sort -u | grep -v '^$' || true)"

if [ -n "$FOUND" ]; then
    echo "Push rejected: the commits being pushed touch local agent config." >&2
    printf '%s\n' "$FOUND" | sed 's/^/  /' >&2
    echo "" >&2
    echo "Removing the file in a later commit does not remove the blob from history." >&2
    echo "Rewrite the range with git filter-repo before pushing." >&2
    exit 1
fi

chain "$@"
